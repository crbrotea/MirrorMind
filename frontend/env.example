# Copy this file to .env.local and fill in values
# cp env.example .env.local

# WebSocket URL for the MirrorMind backend
# Local development:
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws

# Production (set in Vercel dashboard or via CLI):
# NEXT_PUBLIC_WS_URL=wss://mirrormind-backend-XXXXX.us-central1.run.app/ws
